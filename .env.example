# Banco e Redis
MYSQL_DATABASE=app247
MYSQL_USER=app247
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Autenticação JWT. Use um valor aleatório forte e não versione o valor real.
JWT=

# Obrigatório para o HMAC das identidades por CPF.
# Use pelo menos 32 caracteres aleatórios, mantenha o mesmo valor entre réplicas
# e nunca versione o secret real. Rotação ainda não é suportada.
IDENTITY_HASH_SECRET=

# Segredo compartilhado somente para migração/provisionamento legado. A operação
# diária usa uma credencial individual gerada pelo backend para cada Terminal.

# Lista CSV explícita de origins dos clientes browser. Clientes Python sem Origin
# continuam sujeitos à autenticação obrigatória do dispositivo.
WEBSOCKET_ALLOWED_ORIGINS=https://app.exemplo.com,https://admin.exemplo.com
PASSWORD_RECOVERY_WINDOW=PT15M
PASSWORD_RECOVERY_REQUEST_LIMIT=5
PASSWORD_RECOVERY_VALIDATE_LIMIT=5
PASSWORD_RECOVERY_RESET_LIMIT=5
PASSWORD_RECOVERY_CODE_TTL=PT15M
PASSWORD_RECOVERY_TOKEN_TTL=PT15M

# Opcional: validade dos convites de vínculo (ISO-8601 Duration).
TENANT_LINK_INVITATION_TTL=PT72H

# Documentos legais públicos exibidos antes do cadastro no App Cliente.
# Publique URLs HTTPS reais e incremente as versões sempre que o conteúdo mudar.
APP247_TERMS_URL=https://app.exemplo.com/termos
APP247_PRIVACY_URL=https://app.exemplo.com/privacidade
APP247_TERMS_VERSION=2026-09
APP247_PRIVACY_VERSION=2026-09

# OCI Object Storage (Customer Secret Key do usuário OCI; bucket com leitura pública de objetos)
OCI_NAMESPACE=
OCI_REGION=
OCI_BUCKET=app-imagens
OCI_ACCESS_KEY=
OCI_SECRET_KEY=

# Domínio estático do ngrok (sem https://)
NGROK_URL=tayna-fitful-mariko.ngrok-free.dev
